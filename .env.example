# Supabase → Project Settings → Data API (URL) e API Keys (chaves)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "Publishable key" (sb_publishable_...) ou "anon public" (legado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave SECRETA: "Secret key" (sb_secret_...) ou "service_role" (legado).
# Só no servidor: nunca coloque no código nem com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
